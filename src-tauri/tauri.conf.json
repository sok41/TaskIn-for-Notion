{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskIn for Notion",
  "version": "0.1.0",
  "identifier": "com.sok41.taskin-for-notion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "TaskIn for Notion",
        "url": "index.html?window=popup",
        "width": 420,
        "height": 260,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "settings",
        "title": "TaskIn for Notion - 設定",
        "url": "index.html?window=settings",
        "width": 480,
        "height": 680,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
